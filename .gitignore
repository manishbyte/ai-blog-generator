*.db
*.sqlite
*.sqlite3
*.dump
*.sql.gz

# Generated blog output
output/*
!output/.gitkeep

# Generated images
images/*
!images/.gitkeep

# Build and packaging artifacts
build/
dist/
*.egg-info/

# Local environment overrides
.env.local
.env.development.local
.env.test.local
.env.production.local
