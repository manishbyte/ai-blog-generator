__pycache__/
*.py[cod]
*$py.class
*.so

# Testing and coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/

# Type-checker and linter caches
.mypy_cache/
.pyright/
.ruff_cache/

# Streamlit cache
.streamlit/cache/

# Editors and IDEs
.vscode/
.idea/
*.swp
*.swo

